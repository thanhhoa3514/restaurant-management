          <mxGeometry x="350" y="1300" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="X2" value="[HT] Trả 'chưa mở phiên' + hướng dẫn liên hệ nhân viên (mở phiên là bắt buộc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="1305" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- S10 tra ma phien -->
        <mxCell id="S10" value="[HT] Trả mã phiên + thông tin định danh (nhà hàng, bàn, phiên)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="1440" width="220" height="70" as="geometry" />
        </mxCell>
        <!-- S11 luu ma phien -->
