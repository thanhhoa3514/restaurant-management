<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Tiep nhan - Mo phien (flowchart)" id="bp-flowchart">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- START -->
        <mxCell id="S0" value="Khách bước vào nhà hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- S1 -->
        <mxCell id="S1" value="[NV] Tiếp nhận khách, sắp xếp bàn phù hợp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- S2 -->
        <mxCell id="S2" value="[NV] Mở app quản lý → chọn bàn → nhập số khách → xác nhận mở phiên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- D0 input valid -->
        <mxCell id="D0" value="[HT] Bàn tồn tại &amp; số khách hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="340" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="X0" value="[HT] Báo lỗi nhập liệu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="355" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- D1 ban da co phien -->
        <mxCell id="D1" value="[HT] Bàn đã có phiên hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="480" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S3b" value="[HT] Dùng phiên hiện có (không tạo mới, mã phiên cũ còn hiệu lực)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="485" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- S3 tao phien -->
        <mxCell id="S3" value="[HT] Tạo phiên phục vụ mới (OPEN); bàn AVAILABLE → OCCUPIED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="620" width="220" height="70" as="geometry" />
        </mxCell>
        <!-- S4 sinh ma phien -->
        <mxCell id="S4" value="[HT] Sinh mã phiên — chuỗi bí mật, ngẫu nhiên, duy nhất, hiệu lực trong phiên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="720" width="220" height="80" as="geometry" />
        </mxCell>
        <!-- S5 merge -->
        <mxCell id="S5" value="Phiên sẵn sàng phục vụ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="830" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- S6 quet QR -->
        <mxCell id="S6" value="[Khách] Dùng điện thoại quét mã QR tại bàn (QR = mã công khai, cố định, định danh bàn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="920" width="220" height="80" as="geometry" />
        </mxCell>
        <!-- S7 bat tay -->
        <mxCell id="S7" value="[HT] Bắt tay: nhận mã QR → xác định bàn → kiểm trạng thái phiên (điểm vào công khai duy nhất)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="1040" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- D2 QR hop le -->
        <mxCell id="D2" value="[HT] Mã QR hợp lệ / chưa thu hồi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="1160" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="X1" value="[HT] Từ chối yêu cầu + ghi nhận lần quét vào nhật ký sự kiện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="1165" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="E1" value="Kết thúc — QR lỗi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="730" y="1270" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- D3 ban co phien active -->
