        <mxCell id="X3" value="[HT] Từ chối yêu cầu (401) — không suy ra được phiên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="1770" width="200" height="80" as="geometry" />
