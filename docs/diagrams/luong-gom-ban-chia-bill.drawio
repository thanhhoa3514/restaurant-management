  <diagram id="flow-merge-tables" name="1. Gom ban (Phuc vu)">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p1_t" value="LUỒNG: GOM BÀN — tính chung nhiều phiên (vai trò Phục vụ)" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="880" height="24" as="geometry"/></mxCell>
        <mxCell id="p1_s" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="p1_a" value="Nhóm khách đông ngồi nhiều bàn, muốn tính chung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_pick" value="Phục vụ chọn ≥ 2 phiên bàn trên lưới bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_d1" value="Các phiên đều đang mở (ACTIVE)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_err" value="Báo lỗi — chọn lại các phiên hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="620" y="305" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_merge" value="Gộp bàn (POST /restaurant/sessions/merge) → tạo merge_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="240" height="70" as="geometry"/></mxCell>
