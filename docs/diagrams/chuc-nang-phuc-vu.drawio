        <mxCell id="s3b" value="Cả đơn (bulk shortcut)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#8CC9AB;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="384" width="200" height="34" as="geometry" /></mxCell>

