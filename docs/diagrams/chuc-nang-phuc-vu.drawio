  <diagram id="waiter-bfd" name="Chuc nang Phuc vu">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SƠ ĐỒ CHỨC NĂNG — VAI TRÒ PHỤC VỤ (WAITER)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1280" height="30" as="geometry" /></mxCell>

        <mxCell id="root" value="Phục vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E6B4F;strokeColor=#1E4A36;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="200" height="56" as="geometry" /></mxCell>

        <!-- Level 1: 5 chuc nang that (co endpoint) -->
        <mxCell id="f1" value="Xem sơ đồ / lưới bàn&#10;(GET /tables)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEE3;strokeColor=#2E8B57;fontColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f3" value="Đánh dấu đã phục vụ&#10;(PATCH order-items/:id/status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEE3;strokeColor=#2E8B57;fontColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f4" value="Xác nhận gọi nhân viên&#10;(POST sessions/:id/ack-waiter-call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEE3;strokeColor=#2E8B57;fontColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f5" value="Mở phiên cho khách walk-in&#10;(POST staff/sessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEE3;strokeColor=#2E8B57;fontColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="f6" value="Yêu cầu thanh toán hộ khách&#10;(POST sessions/:id/request-bill)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEE3;strokeColor=#2E8B57;fontColor=#1F2937;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="220" width="200" height="60" as="geometry" /></mxCell>

        <!-- Level 2: con cua Xem so do ban -->
