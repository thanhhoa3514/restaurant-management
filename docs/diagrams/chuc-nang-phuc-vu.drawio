        <mxCell id="s1b" value="Theo dõi tín hiệu (ready / gọi NV / yêu cầu bill)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#8CC9AB;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="s1c" value="Xem chi tiết phiên / đơn theo bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#8CC9AB;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="200" height="48" as="geometry" /></mxCell>

