<mxfile host="app.diagrams.net" modified="2026-07-15T00:00:00.000Z" agent="claude-code" version="24.0.0">

  <diagram id="flow-menu-crud" name="1. Quan ly menu (Admin)">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p1_t" value="LUỒNG: QUẢN LÝ MENU — CRUD món + bật/tắt còn hàng (vai trò Admin / Manager)" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1140" height="24" as="geometry"/></mxCell>

        <mxCell id="p1_s" value="Bắt đầu — mở màn Quản lý menu (/admin/catalog)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_auth" value="Đăng nhập JWT + quyền CatalogManage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="p1_list" value="Xem danh sách món + danh mục (GET /menu/items, /menu/categories)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="490" y="210" width="240" height="60" as="geometry"/></mxCell>

        <mxCell id="p1_d1" value="Chọn thao tác" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="220" height="100" as="geometry"/></mxCell>

        <mxCell id="p1_add" value="THÊM món&#10;nhập tên · giá · danh mục (+ ảnh: POST /menu/upload/presign → tải S3)&#10;→ POST /menu/items" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p1_edit" value="SỬA món&#10;đổi tên · giá · mô tả&#10;→ PUT /menu/items/:id" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p1_del" value="XÓA món&#10;→ DELETE /menu/items/:id&#10;(soft delete: deleted_at)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p1_avail" value="BẬT/TẮT còn hàng&#10;→ PATCH /menu/items/:id/availability" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="450" width="250" height="90" as="geometry"/></mxCell>

        <mxCell id="p1_commit" value="Ghi DB + phát sự kiện realtime (outbox) trong cùng 1 transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="490" y="600" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_rt" value="Menu khách cập nhật realtime — ẩn/hiện món, giá mới áp cho đơn MỚI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="490" y="690" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_e" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="790" width="200" height="40" as="geometry"/></mxCell>

        <mxCell id="p1_snap" value="Đổi giá/tên KHÔNG ảnh hưởng đơn &amp; hóa đơn CŨ (đã snapshot lúc đặt)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="600" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p1_gap" value="Danh mục + option/topping/size: hiện chỉ ĐỌC, chưa có CRUD → hướng phát triển" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="170" y="210" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="p1_x1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p1_s" target="p1_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p1_auth" target="p1_list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p1_list" target="p1_d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x4" value="Thêm" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_d1" target="p1_add"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x5" value="Sửa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_d1" target="p1_edit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x6" value="Xóa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_d1" target="p1_del"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x7" value="Còn hàng" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_d1" target="p1_avail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_add" target="p1_commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="p1_edit" target="p1_commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="p1_del" target="p1_commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1_avail" target="p1_commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p1_commit" target="p1_rt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p1_rt" target="p1_e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#D6B656;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_commit" target="p1_snap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_x15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1_list" target="p1_gap"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="flow-qr-table" name="2. Quan ly QR theo ban (Manager)">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p2_t" value="LUỒNG: QUẢN LÝ QR THEO BÀN — tạo / xoay / vô hiệu (vai trò Manager)" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="960" height="24" as="geometry"/></mxCell>

        <mxCell id="p2_s" value="Bắt đầu — mở màn QR theo bàn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_auth" value="Đăng nhập JWT + quyền DiningManage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_list" value="Xem QR các bàn (GET /restaurant/tables/qrs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="400" y="210" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_pick" value="Chọn 1 bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="240" height="50" as="geometry"/></mxCell>

        <mxCell id="p2_d1" value="Bàn đã có QR active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="410" y="370" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_gen" value="Tạo QR mới (POST /tables/qrs) → mint token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="240" height="70" as="geometry"/></mxCell>

        <mxCell id="p2_d2" value="Muốn xoay QR (rotate)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="410" y="510" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_keep" value="Dùng QR hiện tại — idempotent, trả lại QR cũ (không đổi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="740" y="525" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p2_rot" value="Xoay: VÔ HIỆU QR cũ (deactivate, ghi deactivated_by) + mint token MỚI (rotate=true). Đảm bảo 1 QR active/bàn (unique index)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="240" height="90" as="geometry"/></mxCell>

        <mxCell id="p2_print" value="In QR (frontend) → dán lên bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="400" y="780" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="p2_note" value="Token nhúng trong QR → khách quét vào /customer để join phiên bàn" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="775" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="p2_e" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="870" width="200" height="40" as="geometry"/></mxCell>

        <mxCell id="p2_x1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_s" target="p2_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_auth" target="p2_list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_list" target="p2_pick"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_pick" target="p2_d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x5" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_d1" target="p2_gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x6" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_d1" target="p2_d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x7" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_d2" target="p2_keep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x8" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_d2" target="p2_rot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_gen" target="p2_print"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_rot" target="p2_print"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2_keep" target="p2_print"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#4A4A4A;" edge="1" parent="1" source="p2_print" target="p2_e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_x13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#D6B656;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_print" target="p2_note"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
