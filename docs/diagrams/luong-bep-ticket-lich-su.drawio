        <mxCell id="p2_tl" value="PENDING → ACKNOWLEDGED → PREPARING → READY → SERVED (kèm giờ &amp; người thao tác)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="280" y="330" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="p2_use" value="Bếp / quản lý biết món trễ ở khâu nào, ai xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="460" width="240" height="60" as="geometry"/></mxCell>
