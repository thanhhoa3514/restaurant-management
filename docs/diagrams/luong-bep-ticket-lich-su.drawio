        <mxCell id="p1_a" value="Khách đặt món → hệ thống tạo ticket cho bếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1_push" value="Ticket hiện lên màn Bếp (KDS) — tự làm mới, không cần bấm tải lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="210" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="p1_read" value="Bếp xem ticket: tên món, số lượng, tùy chọn, ghi chú, bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="310" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="p1_d1" value="Còn nguyên liệu làm món?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="290" y="410" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_un" value="Đánh dấu Hết món (UNAVAILABLE) → báo khách &amp; phục vụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="620" y="425" width="240" height="70" as="geometry"/></mxCell>
