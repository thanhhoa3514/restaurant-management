        <mxCell id="p1_ready" value="Món xong (READY) → báo phục vụ mang ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="720" width="240" height="60" as="geometry"/></mxCell>
