  <diagram id="flow-callwaiter" name="1. Goi nhan vien">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p1_t" value="LUỒNG: GỌI NHÂN VIÊN (khách bấm chuông từ điện thoại)" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="920" height="24" as="geometry"/></mxCell>
