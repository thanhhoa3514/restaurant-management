        <mxCell id="p1_ob" value="Ghi outbox &quot;dining.waiter_called&quot; (cùng 1 transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="440" width="240" height="60" as="geometry"/></mxCell>
