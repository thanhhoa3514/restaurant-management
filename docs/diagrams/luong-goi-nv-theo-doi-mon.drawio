        <mxCell id="p1_a" value="Khách bấm &quot;Gọi nhân viên&quot; trên điện thoại (POST /customer/call-waiter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="240" height="70" as="geometry"/></mxCell>
