<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Quan ly ma QR theo ban" id="bp-qr">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== SPINE ===== -->
        <mxCell id="S0" value="[Quản lý] Chọn bàn → chọn thao tác mã QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="[HT] Thao tác?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="250" y="245" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH: Sinh ma (top) ===== -->
        <mxCell id="D2" value="[HT] Bàn đã có mã đang hiệu lực?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A1" value="[HT] Trả về đúng mã hiện có (bất biến — gọi lại nhiều lần không tạo mã trùng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="30" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="[HT] Sinh token mới, lưu ánh xạ token ↔ bàn ở máy chủ, đánh dấu hiệu lực" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH: Xoay ma (bottom) ===== -->
        <mxCell id="B1" value="[HT] Trong MỘT giao dịch: vô hiệu hóa mã cũ + cấp token mới → luôn đúng một mã hiệu lực, không có hai mã cùng tồn tại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="430" width="290" height="110" as="geometry" />
        </mxCell>

        <!-- ===== CONVERGE ===== -->
        <mxCell id="M" value="[HT] Trả mã QR cho quản lý để tải / in dán tại bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1030" y="245" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E0" value="Bàn có đúng một mã QR hiệu lực" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1280" y="250" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- ===== NOTE ===== -->
        <mxCell id="NT" value="Ghi chú: mã QR chứa token ngẫu nhiên, KHÔNG chứa định danh bàn. Ánh xạ token ↔ bàn lưu phía máy chủ → token không thể bị suy đoán để truy cập bàn khác; thu hồi / thay mã không cần thay đổi bản thân bàn. Chỉ vai trò Quản lý có quyền sinh / xoay mã. Nguyên tắc: mỗi bàn luôn có đúng một mã hiệu lực tại một thời điểm." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="400" height="170" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e_S0_D1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="S0" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_D1_D2" value="Sinh mã" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D1_B1" value="Xoay mã" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="B1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_D2_A1" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D2" target="A1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D2_A2" value="Chưa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D2" target="A2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_A1_M" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A1" target="M"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_A2_M" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="A2" target="M"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_B1_M" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="B1" target="M"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_M_E0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="M" target="E0"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
