                </mxCell>
                <mxCell id="X2" value="[HT] Trả danh sách lỗi theo từng món (không hủy cả đơn); khách sửa rồi gửi lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
