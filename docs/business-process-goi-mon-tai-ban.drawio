    <diagram name="Goi mon tai ban (flowchart ngang)" id="bp-goi-mon">
        <mxGraphModel dx="2777" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="800" math="0" shadow="0">
            <root>
