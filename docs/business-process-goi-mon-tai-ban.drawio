                <mxCell id="S0" value="Khách mở giao diện gọi món&amp;nbsp;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="200" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="S1" value="Khách chọn món theo nhóm: giá, còn/hết, biến thể (khẩu phần/size), tùy chọn (topping), số lượng, ghi chú" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="290" y="195" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="S2" value="Khách xác nhận gọi món: gửi cả giỏ kèm mã phiên về hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="540" y="200" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="D1" value="Phiên đang ở trạng&amp;nbsp;&lt;div&gt;thái hoạt động?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="800" y="190" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="D2" value="Mọi món trong giỏ hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
