                <mxCell id="G1" value="Món của khách chuyển trạng thái CHỜ XÁC NHẬN (PLACED), hiển thị trên màn hình nhân viên phục vụ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;" parent="1" vertex="1">
