<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Goi mon tai ban (flowchart ngang)" id="bp-goi-mon">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ ROW A (top, left -> right) ============ -->
        <mxCell id="S0" value="Khách mở giao diện gọi món (dùng lại mã phiên đã lưu, không quét lại)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="[Khách] Chọn món theo nhóm: giá, còn/hết, biến thể (khẩu phần/size), tùy chọn (topping), số lượng, ghi chú" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="290" y="195" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="[Khách] Xác nhận gọi món → gửi cả giỏ + mã phiên về hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="[HT] Phiên đang ở trạng thái hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="800" y="190" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="[HT] Mọi món trong giỏ hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1030" y="190" width="170" height="100" as="geometry" />
        </mxCell>

        <!-- ============ FAIL band TOP (D2 -> tra loi) ============ -->
        <mxCell id="X2" value="[HT] Trả danh sách lỗi theo từng món (không hủy cả đơn) — khách sửa rồi gửi lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1030" y="40" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ============ FAIL band MID (D1 -> tu choi) ============ -->
        <mxCell id="X1" value="[HT] Từ chối gọi món (phiên đã chờ thanh toán / đã đóng)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="795" y="340" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="E1" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ============ ROW B (bottom, right -> left) ============ -->
        <mxCell id="S3" value="[HT] Tạo đơn hàng mới + gắn vào phiên phục vụ hiện tại của bàn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1030" y="460" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="[HT] Chốt (snapshot) tên món + giá hiện hành cho từng dòng (đổi giá sau không ảnh hưởng đơn đã đặt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="780" y="460" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="[HT] Phân loại đơn đầu / gọi thêm; đẩy vào hàng đợi bếp; tách phiếu chế biến theo khu (lẩu, nướng…)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="530" y="460" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S6" value="[Bếp] Truy xuất hàng đợi → tiếp nhận → bắt đầu chế biến" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="290" y="465" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="E0" value="Đơn được liên kết phiên qua mã phiên; khách có thể gọi thêm nhiều lần trong cùng phiên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ============ EDGES ============ -->
        <mxCell id="e_S0_S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S0" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S1_S2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S2_D1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S2" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D1_D2" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D1 fail down -->
        <mxCell id="e_D1_X1" value="Không (phiên đóng)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="D1" target="X1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_X1_E1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="X1" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D2 fail up -->
        <mxCell id="e_D2_X2" value="Có món lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="D2" target="X2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_X2_S1" value="Điều chỉnh &amp; gửi lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="X2" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D2 pass -> wrap down to row B -->
        <mxCell id="e_D2_S3" value="Hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D2" target="S3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_S3_S4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S3" target="S4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S4_S5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S4" target="S5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S5_S6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S5" target="S6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S6_E0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="S6" target="E0"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- loop: goi them mon -->
        <mxCell id="e_E0_S1" value="Gọi thêm món (cùng phiên)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="E0" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
