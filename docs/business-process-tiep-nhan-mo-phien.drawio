          <mxGeometry x="700" y="40" width="300" height="1600" as="geometry" />
        </mxCell>

        <!-- ===== COLUMN HEADERS ===== -->
        <mxCell id="hA" value="NHÂN VIÊN (Lễ tân / Phục vụ) — thủ công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hB" value="HỆ THỐNG (Chức năng — tin học hoá)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hC" value="KHÁCH HÀNG — thủ công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- ===== NODES ===== -->
        <!-- n1 start (C) -->
        <mxCell id="n1" value="Khách bước vào nhà hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- n2 (A) -->
        <mxCell id="n2" value="Tiếp nhận khách, sắp xếp bàn phù hợp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="220" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- n3 (A) trigger -->
        <mxCell id="n3" value="Mở app quản lý → chọn bàn trống → nhập số khách → xác nhận MỞ PHIÊN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- n4 (B) function -->
        <mxCell id="n4" value="Tạo phiên phục vụ mới (trạng thái OPEN); chuyển bàn AVAILABLE → OCCUPIED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="330" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- n5 (B) function sinh ma phien -->
        <mxCell id="n5" value="Sinh MÃ PHIÊN — chuỗi bí mật, ngẫu nhiên, duy nhất, chỉ hiệu lực trong phiên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="450" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- note: 2 loai ma -->
        <mxCell id="note5" value="Phân biệt:&#10;• QR = mã công khai, cố định, chỉ định danh bàn&#10;• Mã phiên = vé bí mật, sinh mỗi phiên, mất hiệu lực khi đóng phiên" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="430" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- n6 (C) quet QR -->
        <mxCell id="n6" value="Khách dùng điện thoại cá nhân quét mã QR tại bàn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="730" y="600" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- n7 (B) bat tay -->
        <mxCell id="n7" value="BẮT TAY: nhận mã QR → xác định bàn + kiểm trạng thái phiên (điểm vào công khai duy nhất)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="700" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- d1 (B) decision QR hop le -->
        <mxCell id="d1" value="Mã QR hợp lệ / chưa thu hồi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="425" y="830" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- r1 (A) reject + log -->
        <mxCell id="r1" value="Từ chối yêu cầu + ghi nhận lần quét vào nhật ký sự kiện" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="845" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Kết thúc — QR lỗi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="110" y="960" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- d2 (B) decision ban da mo phien -->
        <mxCell id="d2" value="Bàn đang có phiên hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="425" y="980" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- r2 (A) chua mo phien -->
        <mxCell id="r2" value="Trả 'chưa mở phiên' + hướng dẫn khách liên hệ nhân viên&#10;(mở phiên là điều kiện bắt buộc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="90" y="1000" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- n9 (B) tra ma phien -->
        <mxCell id="n9" value="Trả MÃ PHIÊN + thông tin định danh (nhà hàng, bàn, phiên)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="1140" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- n10 (C) luu ma phien -->
        <mxCell id="n10" value="Điện thoại khách lưu lại mã phiên cho các thao tác sau" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="730" y="1145" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- n11 (B) moi yeu cau gui kem ma phien -->
        <mxCell id="n11" value="Mỗi yêu cầu (xem menu / gọi / sửa / hủy món) gửi kèm mã phiên ở header → kiểm hợp lệ → suy ra phiên + bàn → gắn đơn vào đúng phiên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="1280" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- e2 (C) end -->
        <mxCell id="e2" value="Khách gọi món an toàn trong đúng phiên của mình" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="730" y="1450" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="lg" value="CHÚ THÍCH&#10;▢ Xanh dương = bước thủ công (Nhân viên)&#10;▢ Cam = bước thủ công (Khách)&#10;▢ Xanh lá = chức năng tin học hoá (Hệ thống)&#10;◇ Vàng = điểm quyết định" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1">
