<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Goi them mon" id="bp-goi-them">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== MAIN ROW (L -> R) ===== -->
        <mxCell id="S0" value="[Khách] Đang dùng bữa, muốn gọi thêm món (giao diện đang mở, dùng lại mã phiên — không quét lại QR)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="[Khách] Chọn thêm món → xác nhận gửi (kèm mã phiên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="[HT] Phiên còn đang hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="500" y="135" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="[HT] Mọi món hợp lệ? (còn bán, SL &amp; tùy chọn hợp lệ)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="730" y="135" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="[HT] Tạo đơn mới gắn vào phiên hiện tại, đánh dấu là ĐƠN BỔ SUNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="[HT] Đẩy đơn vào hàng đợi bếp → đi quy trình tiếp nhận / chế biến / phục vụ (như mục trước)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1190" y="135" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E0" value="Đơn bổ sung được ghi nhận và cộng dồn vào hóa đơn duy nhất của bàn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1430" y="135" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- ===== FAIL: phien da cho thanh toan ===== -->
        <mxCell id="X1" value="[HT] Từ chối gọi thêm: phiên đã chuyển chờ thanh toán → tránh phát sinh món sau khi đã yêu cầu tính tiền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="430" y="340" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E1" value="Kết thúc — không thêm món" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="470" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ===== FAIL: gio loi ===== -->
        <mxCell id="X2" value="[HT] Trả danh sách lỗi theo từng món (không hủy cả giỏ) — khách sửa rồi gửi lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="340" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ===== NOTE ===== -->
        <mxCell id="NT" value="Ghi chú: mọi đơn trong cùng phiên (đơn đầu + các đơn bổ sung) đều liên kết qua mã phiên và cộng dồn vào 1 hóa đơn của bàn. Tổng thanh toán = giá trị mọi món đã gọi trong phiên − các món đã bị hủy. Phân biệt đơn đầu / đơn bổ sung chỉ để theo dõi." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="340" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- ===== EDGES main ===== -->
        <mxCell id="e_S0_S1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="S0" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S1_D1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="S1" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D1_D2" value="Còn hoạt động" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D2_S2" value="Hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D2" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S2_S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_S3_E0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="S3" target="E0"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D1 fail -->
        <mxCell id="e_D1_X1" value="Đã chờ thanh toán" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="D1" target="X1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_X1_E1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="X1" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D2 fail -> loop S1 -->
        <mxCell id="e_D2_X2" value="Có món lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="D2" target="X2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_X2_S1" value="Điều chỉnh &amp; gửi lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="X2" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
