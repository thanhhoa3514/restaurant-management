        <mxCell id="e10a" value="Đã cập nhật" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D3" target="X2"><mxGeometry relative="1" as="geometry" /></mxCell>
