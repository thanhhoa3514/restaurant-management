<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Huy - chinh mon" id="bp-huy-chinh">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== SPINE ===== -->
        <mxCell id="S0" value="[Khách] Chọn món muốn hủy / chỉnh sửa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D0" value="[HT] Phiên còn đang hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="250" y="275" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="[HT] Trạng thái của món?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- D0 fail -->
        <mxCell id="X0" value="[HT] Từ chối: phiên không còn hoạt động (đã chờ thanh toán / đã đóng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="EX" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH A: PENDING (truc tiep) ===== -->
        <mxCell id="A1" value="[Khách] Chỉnh trực tiếp: đổi số lượng / tùy chọn / ghi chú; bỏ 1 món; hoặc hủy cả đơn (nếu mọi món đều PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="[HT] Tính lại đơn + cập nhật tổng tiền của phiên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="930" y="50" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="EA" value="Đã cập nhật" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1160" y="55" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH B: PREPARING (gui yeu cau) ===== -->
        <mxCell id="Ddup" value="[HT] Món đã có yêu cầu hủy đang mở?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B1" value="[Khách] Gửi yêu cầu hủy kèm lý do" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="910" y="280" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="[HT] Ghi nhận yêu cầu ở trạng thái Chờ xử lý; khóa: mỗi món chỉ 1 yêu cầu mở" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1120" y="275" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="EB" value="Chờ bếp duyệt (sang QT duyệt yêu cầu hủy)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1350" y="280" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Xdup" value="[HT] Từ chối: đã có yêu cầu hủy đang mở (tránh gửi trùng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH C: READY / SERVED (cam) ===== -->
        <mxCell id="C1" value="[HT] Từ chối: món đã READY / SERVED — không được hủy trên giao diện khách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="EC" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="930" y="570" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- ===== NOTE ===== -->
        <mxCell id="NT" value="Nguyên tắc: càng về sau trong vòng đời món, điều kiện thay đổi càng chặt — tự do chỉnh/hủy khi còn PENDING, chỉ được gửi yêu cầu khi PREPARING, không được hủy khi đã READY/SERVED. Mục đích: hạn chế lãng phí nguyên liệu và sai lệch dữ liệu thanh toán." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1">
          <mxGeometry x="1140" y="450" width="400" height="130" as="geometry" />
        </mxCell>

