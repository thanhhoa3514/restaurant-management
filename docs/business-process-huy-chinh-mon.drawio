        <mxCell id="e_D0_D1" value="Còn hoạt động" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D0" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D0_X0" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="D0" target="X0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_X0_EX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="X0" target="EX"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- D1 three-way -->
        <mxCell id="e_D1_A1" value="PENDING (chưa vào bếp)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="A1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_D1_Ddup" value="PREPARING (đang chế biến)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="D1" target="Ddup"><mxGeometry relative="1" as="geometry" /></mxCell>
