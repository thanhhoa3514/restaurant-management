        <mxCell id="e_Ddup_Xdup" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="Ddup" target="Xdup"><mxGeometry relative="1" as="geometry" /></mxCell>

