                <mxCell id="P0" value="Nhân viên phục vụ đăng nhập&amp;nbsp;&lt;div&gt;và mở màn hình phục vụ&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
