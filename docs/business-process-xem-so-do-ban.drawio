                </mxCell>
                <mxCell id="P1" value="Hệ thống lấy danh sách bàn kèm khu vực, phiên phục vụ, đơn hàng và từng món" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
