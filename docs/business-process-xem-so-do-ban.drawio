                <mxCell id="X_ERR" value="Hệ thống báo lỗi truy vấn hoặc quá thời gian chờ; giao diện giữ nguyên dữ liệu gần nhất và hiển thị nút thử lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
