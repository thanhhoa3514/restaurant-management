    <diagram name="Xem so do ban va luoi ban (flowchart ngang)" id="bp-xem-so-do-ban">
        <mxGraphModel dx="1213" dy="628" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="720" math="0" shadow="0">
            <root>
