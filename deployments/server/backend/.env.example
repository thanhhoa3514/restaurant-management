# Image tag loaded via `docker load` (matches build-release.sh: prod or uat).
TAG=prod

APP_ENV=production
LOG_LEVEL=info

# 'postgres' / 'minio' = container names on the shared 'restaurant' docker network.
DATABASE_URL=postgres://postgres:CHANGE_ME_strong_db_password@postgres:5432/restaurant?sslmode=disable

JWT_SECRET=CHANGE_ME_long_random_string
JWT_TTL=12h

# Staff login password created by seed (manager/waiter/kitchen/cashier accounts).
DEMO_SEED_PASSWORD=CHANGE_ME_staff_login_password

# MUST include the public domain (apex + www) or CORS/websocket gets rejected.
CORS_ALLOWED_ORIGINS=https://jackiengo.io.vn,https://www.jackiengo.io.vn
PUBLIC_BASE_URL=https://jackiengo.io.vn

# ── SePay Test Mode ───────────────────────────────────────────────────────────
# Use the exact same secret configured for the SePay HMAC-SHA256 webhook.
SEPAY_BANK_CODE=Vietcombank
SEPAY_ACCOUNT_NUMBER=0000000001
SEPAY_ACCOUNT_NAME=HO KINH DOANH TEST 3CBA
SEPAY_WEBHOOK_SECRET=CHANGE_ME_same_secret_as_sepay_dashboard
SEPAY_QR_BASE_URL=https://vietqr.app/img
# DANGER — demo only. Set 5000 only for a controlled live-bank flow test.
# Reset to 0 before accepting real customer payments.
SEPAY_DEMO_AMOUNT_VND=0

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_strong_minio_password
S3_BUCKET=restaurant-images
S3_USE_SSL=false
# Public URL browsers load images from — edge nginx proxies /restaurant-images/ → minio.
# Baked into DB rows at seed time → changing it requires re-running seed.
S3_PUBLIC_URL=https://jackiengo.io.vn/restaurant-images
