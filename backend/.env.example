# Backend environment configuration — copy to .env and adjust.
# Every var is optional in development (defaults shown); some are REQUIRED in production.

# ── HTTP server ──────────────────────────────────────────────
# Listen address for the API server.
HTTP_ADDR=:8080

# Graceful shutdown window. Accepts a Go duration ("10s", "1m") or a bare integer (seconds).
SHUTDOWN_SECONDS=10s

# ── Environment ──────────────────────────────────────────────
# "development" | "production". In production, gin runs in release mode and
# JWT_SECRET must be overridden (see below) or startup validation fails.
APP_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Database (Postgres) ──────────────────────────────────────
# pgx connection URL. Use sslmode=require (or stricter) in production.
# Default host port 5440 matches deployments/docker-compose.yml (POSTGRES_PORT).
DATABASE_URL=postgres://postgres:postgres@localhost:5440/restaurant?sslmode=disable

# Max pool connections. 0 = pgx default (4 per CPU).
DB_MAX_CONNS=0

# ── Auth (JWT) ───────────────────────────────────────────────
# HS256 signing secret. Dev default is "dev-change-me".
# REQUIRED in production — boot fails if left at the default when APP_ENV=production.
# Generate: openssl rand -base64 48
JWT_SECRET=dev-change-me

# Staff token lifetime. Go duration ("12h", "30m") or bare integer (seconds).
JWT_TTL=12h

# ── CORS / WebSocket origins ─────────────────────────────────
# Comma-separated allowlist for CORS and the /ws upgrade (CSWSH guard).
# Empty/unset = allow all (DEV ONLY). In production, list every browser origin:
# staff frontend AND the QR-guest frontend (guests connect to /ws).
# CORS_ALLOWED_ORIGINS=https://staff.example.com,https://guest.example.com
CORS_ALLOWED_ORIGINS=

# ── Seed command (cmd/seed) only ─────────────────────────────
# Password set on demo users by `make seed`. Unset = "demo1234".
# Override for any shared/non-local database. Never reuse a real credential.
DEMO_SEED_PASSWORD=
