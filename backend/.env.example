
HTTP_ADDR=:8080


SHUTDOWN_SECONDS=10s

APP_ENV=development


LOG_LEVEL=info


DATABASE_URL=postgres://postgres:postgres@localhost:5440/restaurant?sslmode=disable


DB_MAX_CONNS=0


JWT_SECRET=dev-change-me

JWT_TTL=12h


CORS_ALLOWED_ORIGINS=

# ── SePay VietQR + webhook ────────────────────────────────────
# Test Mode example. Replace all three bank values before going Live.
SEPAY_BANK_CODE=Vietcombank
SEPAY_ACCOUNT_NUMBER=0000000001
SEPAY_ACCOUNT_NAME=HO KINH DOANH TEST 3CBA
# Generate with: openssl rand -hex 32
SEPAY_WEBHOOK_SECRET=
SEPAY_QR_BASE_URL=https://vietqr.app/img
# DANGER — demo only. 0 requires the exact invoice total. A positive value
# generates the QR for that amount and settles the full invoice when it arrives.
SEPAY_DEMO_AMOUNT_VND=0

DEMO_SEED_PASSWORD=

# ── docker compose interpolation (optional overrides) ─────────
# These are only used when running `docker compose up`. Each has a
# built-in default in docker-compose.yml — uncomment only to override.
# POSTGRES_VERSION=15-alpine
# POSTGRES_DB=restaurant
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432
# GO_VERSION=1.26
# ALPINE_VERSION=3.22
# APP_PORT=8080
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minio-secret

# ── S3-compatible storage (MinIO local / R2 production) ──────
# Endpoint for MinIO (localhost:9000) or R2 (<account>.r2.cloudflarestorage.com).
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minio-secret
# Bucket name for restaurant images.
S3_BUCKET=restaurant-images
S3_USE_SSL=false
# Public URL prefix for serving images (without trailing slash).
S3_PUBLIC_URL=http://localhost:9000/restaurant-images
