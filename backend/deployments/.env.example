# Copy to .env (next to docker-compose.yml) and adjust.
# docker compose auto-loads .env for ${VAR} interpolation.
#   cp .env.example .env && docker compose up

# --- Postgres service ---
POSTGRES_VERSION=15-alpine
POSTGRES_DB=restaurant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- App build args ---
GO_VERSION=1.26
ALPINE_VERSION=3.22
APP_PORT=8080

# --- App runtime (see internal/platform/config/config.go) ---
# NOTE: if you change any POSTGRES_* above, update DATABASE_URL to match —
# compose interpolation is single-pass and won't compose it for you.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/restaurant?sslmode=disable
HTTP_ADDR=:8080

# REQUIRED in production: app refuses to start if APP_ENV=production and this
# is left at the default. Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-change-me
JWT_TTL=12h

SHUTDOWN_SECONDS=10
APP_ENV=development
LOG_LEVEL=info
# 0 = pgx pool default.
DB_MAX_CONNS=0
# Comma-separated; empty = allow all (dev only). Set staff + QR-guest origins in prod.
CORS_ALLOWED_ORIGINS=

# Used only by the seed command (cmd/seed), not the API.
DEMO_SEED_PASSWORD=
