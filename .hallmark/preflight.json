{
  "stack": "React 19, TypeScript, Vite, Tailwind CSS 4, TanStack Router and Query",
  "existing_tokens": "frontend/src/index.css",
  "fonts": ["SF Pro Display", "SF Pro Text", "SF Mono"],
  "theme_modes": ["light", "dark"],
  "motion_library": null,
  "design_genre": "modern-minimal",
  "macrostructure": "Workbench",
  "tone": "utilitarian/austere",
  "audience": ["restaurant manager", "cashier"],
  "primary_jobs": ["find paid invoices", "review revenue", "inspect invoice details"],
  "imagery": "none",
